#else
        for(int m=0;m<NR_MF;++m) for(int c=0;c<8;++c)
            a[m][c]=nr_round_f16(wgt_f32[pc.ars_off+uint(n)*16u+rbase+uint(c)]*NR_Y(m,n,c));
