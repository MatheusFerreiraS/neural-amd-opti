// ---- NR_IMGOUT_REGS: the RGB projection out of the accumulator -------------
//
// **`image_features` is the whole reason this adapter cannot take the one-wave
// shape**, and it does not have to exist. The array is 64 tokens x 32 channels
// of `NR_F16` = **4096 B**, on top of `lds_k` (2048) and `lds_v` (2048), which
// is the measured 8192 B; at one wave that is 8192 B a *wave* and four
// subgroups a SIMD, against the eight the shipping two-wave shape gets. Delete
// it and one wave is 4096 B a wave - the knee - and the window keeps the -13.5%
// VALU that the token split costs.
//
// It can go because **a token never crosses a wave**. The accumulator's map is
// already relied on twice in this file (the `_ds` pooling epilogue's `px/py`,
// and the fused blend's `slot`): component `c` of lane `l` of the stage-6
// fragment (m, n) is
//
//     token   = tok0 + m*16 + (l % 16)          channel = n*16 + 8*(l/16) + c
//
// so the 32 channels of one token live in exactly two lanes, `l` and `l ^ 16`,
// across the two n fragments. One `v_permlanex16` per component hands a lane
// the eight channels it is missing, and the projection is then a per-lane loop
// over channels 0..31 **in the original's order**, so every f32 sum is the same
// sum in the same sequence. Byte-identical is the acceptance test, not a hope.
//
// Two fragments are paired so no lane computes a token twice: the even `m`
// feeds the low half-wave and the odd `m` the high one, and
// `token = tok0 + 2p*16 + lane` is that pairing for both halves at once. The
// tail is accumulated *inside* the n loop - channels 0..15 when n=0 and 16..31
// when n=1 - which is why the only value carried across is `vec3 o` per pair
// and one f16 accumulator fragment, rather than the whole 64x32 block.
//
// **The pair must travel packed.** Widening the two channels to f32 before the
// select and the shuffle is the same arithmetic on paper and not the same ISA:
// ACO contracts `float(f16) * float(f16)` pairs and stops contracting when the
// sources stop being halves. The picture moved by one code on 0.4% of channel
// samples - `cmp` caught it, a mean would not have. Packed in a uint it is
// byte-identical, and the exchange is one instruction for two channels.
//
// **Measured, and it does not pay. Default off.**
//
//   config                    LDS  VGPR  wv  ins/win  cyc/win   us 1080p  us 4K
//   ship            fw2      8192   192   8     6940     8690      693.0   2839
//   NR_IMGOUT_REGS  fw2      4096   144  10     6406     8184      685.9   2795
//   NR_IMGOUT_REGS  fw1      4096   192   8     5928     7720      692.9   2799
//
// The one-wave shape is reached exactly where the occupancy law puts it - 4096
// B on one wave, 192 VGPRs, eight subgroups a SIMD - and both extents are
// `cmp`-identical to the shipping build. **-11.2% of modelled cycles is -1.4%
// of the dispatch at 4K and 0.0% at 1080p**, and the two-wave variant, which
// keeps the instruction count and only drops the LDS round trip and one
// barrier, measures the same -1.5%. This dispatch is not paying for its
// instructions: `fswin32` matches the WMMA-rate cycle model to 3% and `imagepost32`
// already beats it by 15% at the shipping shape, so cutting instructions only
// takes up slack. Frame A/B, two interleaved passes an extent, byte-identical:
// a wash at both. Do not rebuild this to chase the instruction count - the open
// question is what the ~690 us floor is.
#if NR_IMGOUT_REGS && (NR_MF % 2) != 0
#error "NR_IMGOUT_REGS pairs token fragments: NR_MF must be even (NR_FWAVES 1 or 2)"
#endif
#if !NR_IMGOUT_REGS
// Keep the final half features inside the workgroup instead of writing and
// rereading a complete C32 image. Every token/channel is initialized below.
shared NR_F16 image_features[64*32];
#endif
#endif

// Where the block's 64 tokens come from.
//
//   0  **window-major**: workgroup i reads bytes [i*64*C, (i+1)*64*C). The host
//      gathers the windows, applies the shift, and gathers again for the next
//      layer. This is what every gold score in the corpus was produced with and
//      it is kept because those scores are the only external check there is.
//
//   1  **the kernel addresses the image.** A window is 2x2 tiles of 4x4 pixels
//      and the shift is exactly *one tile*, so window (wx, wy) owns global tiles
//      `(2*wx + sh + q%2, 2*wy + sh + q/2)` for q in 0..3 - no straddling, no
//      per-pixel gather. The output goes back to the tile it came from, which is
//      the cyclic shift's reverse, and since the grid is `ceil(W/8)` and decision
//      1 pads W to a multiple of 16, every tile belongs to exactly one window and
//      nothing is written twice.
//
// **Mode 1 is what a graph runner needs and mode 0 cannot be made into one.**
// Consecutive layers alternate the shift and `_ds` layers halve the resolution,
// so a window-major arena would have to be re-gathered on the host between every
// pair of layers - which is the whole frame's worth of memory traffic, on the
// CPU, 152 times.
#ifndef NR_IMAGE
#define NR_IMAGE 0
#endif

#ifdef NR_FUSED_POST_BLEND
#if !NR_IMAGE || !defined(NR_INPUT_F16) || !defined(NR_FINAL_F16) || NR_C != 32
#error NR_FUSED_POST_BLEND requires the C32 image post kernel
#endif
#endif
// ---- NR_PERSIST: one dispatch for a run of consecutive blocks -------------
//
// **The barrier between two fused-Swin layers of one level is a whole-device
// drain, and the dependency it enforces is not whole-device.** A window reads
// the four tiles it owns, shifted by one tile, so layer i+1's window (wx, wy)
// depends on at most four of layer i's windows and on nothing else. Under
// NR_PERSIST a run of such layers is one dispatch over items `(layer, window)`
// numbered layer-major, **claimed off one atomic counter**, and a consumer
// spins on the four producer flags it actually needs.
//
// Nothing about the arithmetic moves. The body below is the same body, run
// once per claimed item, with `pc` coming out of the weight arena instead of
// the push block and the window coordinate coming out of the item instead of
// `gl_WorkGroupID`.
//
// **It cannot deadlock, and it does not need every workgroup to be resident.**
// Every producer of item n has an index below n, and if the counter has
// reached n then every item below n has already been claimed - by a workgroup
// that is, by definition of having claimed it, running. So a producer is
// either finished or being worked on right now, whatever else the device is
// doing with its WGPs: a compositor or the game's own shaders can hold half
// the machine and the only cost is throughput. (The earlier revision dealt
// item i to workgroup `i % gridDim` statically, which is correct only while
// all of them are launched at once - exactly the assumption a shared GPU
// breaks.) The budget below stays as the last line of defence for a wiring
// bug: a whole-dispatch poll budget per workgroup, so the worst case is one
// timeout's wall time and not one per item - past it every wait returns
// immediately, the error word carries the layer, and the host prints it. A
// wrong picture, bounded in time - never a hang.
//
// The claim is broadcast **through global memory, not LDS**: one `shared uint`
// costs a kilobyte of LDS at the 1 KB allocation granularity, which at C=256
// is 32768 -> 33792 bytes and a workgroup per WGP. Word `[4 + total_windows +
// workgroup]` of the sync region is that broadcast slot, and it costs one
// round trip to L2 per item against a window body of tens of microseconds.
#if NR_PERSIST
#if !NR_IMAGE || NR_DUMP || (defined(NR_POOL_F16) && !NR_PERSIST_DS) || defined(NR_INPUT_F16) \
 || defined(NR_FINAL_F16) || defined(NR_FUSED_POST_BLEND) \
 || defined(NR_FUSED_IMAGE_INPUT) || defined(NR_FUSED_IMAGE_OUTPUT)
#error NR_PERSIST applies to the plain image-mode block only
#endif
#if !NR_COHERENT_ACT
// **The one place in this project that still needs `coherent` on the arena.**
// A persistent dispatch consumes what another *workgroup of the same dispatch*
// produced, so there is no barrier between the two and no invalidate: the only
// statement that reaches is device scope on the access itself.
// `NR_COHERENT_ACT` is off by default for every other kernel - the boundary
// invalidates instead - which would have left this one reading its own L0.
// Build it with `NR_COHERENT_ACT=1`.
#error NR_PERSIST needs NR_COHERENT_ACT=1; a persistent dispatch has no boundary to invalidate at
#endif
// **Re-priced with the boundary invalidate, and it is still a win.** The -2.79% this
// was taken at was measured when every kernel was coherent and device scope on
// these four cost nothing extra. It is not free now - `g_fswinp<C>` are the
// only `scope:SCOPE_DEV` left in the graph and they are ~31% of the frame - and
// it still pays. Two interleaved passes an extent, default against
// `NR_NO_PERSIST=1`:
//
//   1080p   on  7.823 / 7.828 ms @ 2715/2719 MHz   21.24 / 21.28 Mcyc   2.673 J
//           off 8.032 / 8.035    @ 2750/2749       22.09 / 22.09        2.735 J
//   4K      on 28.940 / 28.965   @ 2605/2605       75.39 / 75.44        9.855 J
//           off 29.291 / 29.285  @ 2625/2626       76.89 / 76.90        9.973 J
//
// **-2.6% of time and -2.3% of energy at 1080p, -1.1% and -1.2% at 4K.** Read
// the clock column before the cycle column: the non-persistent graph boosts
// 35 MHz higher at 1080p because its extra barriers leave the card idle, so its
// cycle count overstates the gap by a third. Energy a frame is the invariant
// and it says the same thing.
//
// **The spin's flag load is inside the loop** - the hoisting hazard does not reach
// here. ACO lowers `atomicAdd(nr_sync[idx], 0u)` to a plain
// `buffer_load_b32 ... scope:SCOPE_DEV` (which is the right lowering: the scope
// is what the construct was for), and in `g_fswinp256` that load is the first
// instruction of the loop's own basic block, with both back edges - the budget
// path and the poll path - targeting it. A hoist is impossible here because the
// loop's exit condition is the comparison against its result; the synthetic
// probe that was hoisted had nothing else in the loop to keep it honest.
// Laid out exactly as `PushFSwin` in windows/src/core/nr_graph.cpp - twenty uints,
// two of them read as signed - because the host uploads that struct verbatim.
struct FSwinParams {
    uint x_off, o_off, e_off, ct_off, qkv_off, op_off, b_off,
         rs_off, ars_off, s_off, rsd_off, ard_off, mid_off;
    uint tiles_x, tiles_y;
    int  shift, shift_y;
    uint pool_off, pool_tiles_x, pool_tiles_y;
#ifdef NR_DS_PROJECT
    // NR_PERSIST_DS: the run's last layer may be the level's downsample,
    // whose eleven projection fields come from a table at pcp.ds_off.
    uint ds_w_off, ds_o_off, ds_otx, ds_raster, ds_crow, ds_rows, ds_mode, ds_writer_rows, ds_n;
    uint ds_clear_x, ds_clear_y;
#endif
#ifdef NR_FUSED_UPS_BLEND
    // NR_PERSIST_UPS: PushUps then the projection weights, from pcp.ds_off.
    uint blend_p_off, blend_s_off, blend_o_off, blend_g_off;
    uint blend_tiles_x, blend_tiles_y, blend_itiles_x, blend_itiles_y;
    uint blend_mode, blend_stiles_x;
    uint ups_weight_off;
#endif
};
// Four more the host appends per layer, because **consecutive layers of one
// level do not share a window grid**: the grid is padded per axis for the
// shift, so at C=256 and 1080p it alternates 16x9 and 15x9 every two layers.
// [20] gx, [21] gy, [22] windows, [23] the layer's base in the flag array.
#define NR_PARAM_WORDS 24u
FSwinParams pc;
layout(push_constant) uniform PushPersist {
    uint layers_off;    // u32 index into the weight arena of the record array
    uint sync_off;      // u32 index into the activation arena of the sync region
    uint n_layers, spin_limit;
    uint total_windows; // the item count: the sum of the run's window counts
    uint df_off, df_n0; // NR_PERSIST_DF: dependency tables, ready-at-start count
#if NR_PERSIST_DS || NR_PERSIST_UPS
    uint ds_off;        // u32 index of the DS (last) or UPS (first) layer's 11 fields, 0 = none
#endif
} pcp;
#ifndef NR_PERSIST_DF
#define NR_PERSIST_DF 0
#endif
// [0] the item counter, [1] finished, [2] epoch, [3] error,
// [4 .. 4 + total_windows) the flags, then one broadcast slot per workgroup.
layout(set = 0, binding = 5, std430) coherent buffer Sync { uint nr_sync[]; };
uint nr_wx, nr_wy;
#else
#define nr_wx (gl_WorkGroupID.x)
#define nr_wy (gl_WorkGroupID.y)
layout(push_constant) uniform Push {
    uint x_off, o_off, e_off, ct_off, qkv_off, op_off, b_off,
         rs_off, ars_off, s_off, rsd_off, ard_off,
         mid_off;               // the grouped middle convolution, heads > 1
#if NR_IMAGE
    uint tiles_x, tiles_y;      // the image in 4x4-pixel tiles
    int shift, shift_y;        // signed offsets, in 4-pixel tiles
#if defined(NR_POOL_F16) || defined(NR_FUSED_POST_BLEND) || defined(NR_FUSED_UPS_BLEND)
    uint pool_off, pool_tiles_x, pool_tiles_y;
#endif
#endif
#ifdef NR_DS_PROJECT
    // The learned [2C][C] downsample projection, fused after the pool.
    // Same fields as gemmds's shear epilogue (gemm1x1.comp, NR_DS_SHEAR).
    uint ds_w_off, ds_o_off, ds_otx, ds_raster, ds_crow, ds_rows, ds_mode, ds_writer_rows, ds_n;
    uint ds_clear_x, ds_clear_y;  // C>=64 real pooled extent; zero outside (gemmds clear_x/y)
#endif
#if defined(NR_FUSED_POST_BLEND) || defined(NR_FUSED_UPS_BLEND)
    uint blend_p_off, blend_s_off, blend_o_off, blend_g_off;
    uint blend_tiles_x, blend_tiles_y, blend_itiles_x, blend_itiles_y;
    uint blend_mode, blend_stiles_x;
#endif
#if defined(NR_FUSED_UPS_PROJECT) || defined(NR_WIDE_UPS_PROJECT)
    uint ups_weight_off;
#endif
#ifdef NR_FUSED_IMAGE_OUTPUT
    uint image_w_off;
    float image_intensity;
#endif
#ifdef NR_FUSED_IMAGE_INPUT
    uint image_lift_off,image_source_W,image_source_H,image_seed;
    float image_style,image_tone,image_structure,image_skin,image_other,image_noise,image_constant;
#endif
} pc;
