#if NR_QUANT_PAIRED
            NR_F16 means[8];
#else
#endif
#if NR_POOL_DPP16
            float meansf[8];
#define NR_POOL_Q(c) nr_quant_pair32(vec2(meansf[c], meansf[(c)+1]))
#else
#define NR_POOL_Q(c) nr_quant_pair(f16vec2(means[c], means[(c)+1]))
#endif
#if NR_POOL_ADDR_UNIFORM
