// ---- NR_QBATCH: one MODE window for a whole fragment ----------------------
//
// Mode 4's saturating convert needs `MODE.FP16_OVFL` set, and ACO brackets
// **each run of adjacent converts** with an `s_setreg` pair - not each convert.
// At C=32 the shipping kernel has 187 converts and 163 setregs, i.e. runs of
// 2.3, because the source interleaves `activation -> convert -> store` per
// channel pair and the scheduler keeps that order.
//
// The 2026-09-17 thread trace priced those 163 setregs at **9.97% of the
// dispatch** against 7.5% for the 187 converts they guard: the toggle, not the
// conversion, is the cost, and it is the one stall ten waves a SIMD cannot
// hide because it drains the pipe. "Batch the conversions" was once rejected on an
// instruction count (3289 -> 3277) - the right metric was never instructions.
//
// So: stage all four activated pairs of a fragment, convert the four back to
// back, then store. Same operations on the same values in the same order per
// element, so the output is bit-identical; only the run length changes.
#ifndef NR_QBATCH
#define NR_QBATCH 0
#endif
// Mode 4 only: mode 5's `nr_quant_pair32` clamps in f32 before narrowing, which
// is a different function from its `nr_quant_pair`, so the f32 staging below
// would not be bit-identical there.
#if NR_QBATCH && NR_QUANT_PAIRED && NR_QUANT_MODE == 4
#define NR_QBATCH_ON 1
#else
#define NR_QBATCH_ON 0
#endif
#if NR_QBATCH_ON
// The generic form: PAIR(c) is a macro giving the half pair for channels c and
// c+1, already in the spelling that reaches the free converter. **Do not
// rewrite the expression while batching it** - the `f2e4m3fn_satfn` match is
// on the operand's provenance, and losing it costs more MODE writes than
// batching saves (see the packed-multiply note at the softmax).
// **Stage the widened f32, not the half pair.** `nr_quant_pair(f16vec2 v)` is
// `vec2 x = vec2(v)` followed by the saturating convert, so at mode 4 it is
// `nr_quant_pair32(vec2(v))` instruction for instruction. Batching the half
// pairs alone left the two `v_cvt_f32_f16` of each pair inside the run, and
// ACO sank each convert to its own widening - runs of one, which is what the
// shipping kernel already had. Hoisting the widenings is what makes the run.
#define NR_QRUN8(DST, PAIR) {                                                 \
        const vec2 nrr_x0 = vec2(PAIR(0));                                    \
        const vec2 nrr_x1 = vec2(PAIR(2));                                    \
        const vec2 nrr_x2 = vec2(PAIR(4));                                    \
        const vec2 nrr_x3 = vec2(PAIR(6));                                    \
        const NR_QPAIR_T nrr_q0 = nr_quant_pair32(nrr_x0);                    \
        const NR_QPAIR_T nrr_q1 = nr_quant_pair32(nrr_x1);                    \
        const NR_QPAIR_T nrr_q2 = nr_quant_pair32(nrr_x2);                    \
        const NR_QPAIR_T nrr_q3 = nr_quant_pair32(nrr_x3);                    \
        DST[0] = nrr_q0.x; DST[1] = nrr_q0.y;                                 \
        DST[2] = nrr_q1.x; DST[3] = nrr_q1.y;                                 \
        DST[4] = nrr_q2.x; DST[5] = nrr_q2.y;                                 \
        DST[6] = nrr_q3.x; DST[7] = nrr_q3.y; }
#define NR_QBLOCK8(DST, A) {                                                  \
        const f16vec2 nrq_v0 = nr_act2(NR_N2_EQ(A[0], A[1]));                 \
        const f16vec2 nrq_v1 = nr_act2(NR_N2_EQ(A[2], A[3]));                 \
        const f16vec2 nrq_v2 = nr_act2(NR_N2_EQ(A[4], A[5]));                 \
        const f16vec2 nrq_v3 = nr_act2(NR_N2_EQ(A[6], A[7]));                 \
        const vec2 nrq_x0 = vec2(nrq_v0);                                     \
        const vec2 nrq_x1 = vec2(nrq_v1);                                     \
        const vec2 nrq_x2 = vec2(nrq_v2);                                     \
        const vec2 nrq_x3 = vec2(nrq_v3);                                     \
        const NR_QPAIR_T nrq_q0 = nr_quant_pair32(nrq_x0);                    \
        const NR_QPAIR_T nrq_q1 = nr_quant_pair32(nrq_x1);                    \
        const NR_QPAIR_T nrq_q2 = nr_quant_pair32(nrq_x2);                    \
        const NR_QPAIR_T nrq_q3 = nr_quant_pair32(nrq_x3);                    \
        DST[0] = nrq_q0.x; DST[1] = nrq_q0.y;                                 \
        DST[2] = nrq_q1.x; DST[3] = nrq_q1.y;                                 \
        DST[4] = nrq_q2.x; DST[5] = nrq_q2.y;                                 \
        DST[6] = nrq_q3.x; DST[7] = nrq_q3.y; }
#endif

#define NR_EXP_A 0.044910375
#define NR_EXP_B 1.300894618
#define NR_EXP_LO 1.03125
#define NR_EXP_HI 1.569335938
#define NR_LOGIT_LO float((NR_EXP_LO - NR_EXP_B) / NR_EXP_A)
#define NR_LOGIT_HI float((NR_EXP_HI - NR_EXP_B) / NR_EXP_A)
#define NR_SUM_FLOOR 6.103515625e-05

// exp() as a linear ramp in the **f16** bit pattern. The affine map lands the
// clamped logit in [1.03125, 1.5693], which is exactly where an f16's exponent
// field advances one step per unit, so shifting that pattern into f32's
// exponent position *is* an exponential - slope 1.437132 against log2(e)'s
// 1.442695. The mask and the bias are measured, not derived.
float nr_fast_exp(float x) {
    return nr_swin_exp(x);
}

// Which of the two f16 roundings the emulated accumulator uses. This is a
// 26-instruction function against a 3-instruction one, applied after every
// NR_ACC_F16 k-steps of every stage, so it is not a detail: at C=32 the exact
// version is most of why this kernel issues 10119 instructions where
// `fswin.comp` - which has defaulted to the cheap one since it was written -
// issues 2636, and most of why its code is 58804 bytes against 23152, well
// past the instruction cache.
//
// The cheap one is exact on the reachable domain wherever the accumulator is
// on its way to an e4m3 quantisation, which is the argument written out at
// `nr_round_f16_e4m3` in `windows/shaders/rdna4/include/coopmm.glsl`. Every NR_RND site here
// but the final projection is such a place. Keep 0 available: the claim that
// it is free is a claim about a gold score, so the fswin benchmark measures
// both rather than asserting it.
#ifndef NR_ACC_F16_CHEAP
#define NR_ACC_F16_CHEAP (1-NR_PTX_ACC)
#endif
#if NR_ACC_F16 > 0
#if !NR_ACC_F16_CHEAP
#define NR_RND1(x) nr_round_f16(x)
#elif NR_ROUND_MODE == 1
#define NR_RND1(x) nr_round_f16_hw(x)
#elif NR_ROUND_MODE == 2
#define NR_RND1(x) nr_round_f16(x)
#else
#define NR_RND1(x) nr_round_f16_e4m3(x)
#endif
#if NR_ROUND_MODE == 3
// The whole fragment at once: f32 Accumulator -> f16 Accumulator -> back. The
// f16 form packs two components per VGPR, so this is a packed narrowing where
// the per-component paths are scalar ones. Whether it survives ACO is the
// question - `NR_ROUND_MODE=1`'s scalar round trip did not.
#define NR_RND(a) { (a) = NR_FRAG_ACC(NR_FRAG_ACC16(a)); }
#else
#define NR_RND(a) { for (int c = 0; c < (a).length(); ++c) (a)[c] = NR_RND1((a)[c]); }
#endif
#else
#define NR_RND(a) {}
#endif

