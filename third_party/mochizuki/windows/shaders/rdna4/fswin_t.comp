#if NR_POOL_PACKED == 3
                wf[c] = a[m][c]
#if !NR_PTX_ACC
                    + wgt_f32[pc.ars_off + uint(n) * 16u + rbase + uint(c)]
                      * NR_Y(m, n, c)
#endif
                    ;
                wide[c] = NR_F16(wf[c]);
#else
                wide[c] = NR_F16(a[m][c]
#if !NR_PTX_ACC
                    + wgt_f32[pc.ars_off + uint(n) * 16u + rbase + uint(c)]
                      * NR_Y(m, n, c)
#endif
                    );
#endif
#if NR_QUANT_PAIRED
            }
            for (int c=0;c<8;c+=2) {
