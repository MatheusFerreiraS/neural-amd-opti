#ifndef NR_NORM_F32
#define NR_NORM_F32 0
#endif
#ifndef NR_NORM_LATE_SHUFFLE
#define NR_NORM_LATE_SHUFFLE 0
#endif
#ifndef NR_ABLATE_OOB
#define NR_ABLATE_OOB 0
#endif
#ifndef NR_ABLATE_NORM
#define NR_ABLATE_NORM 0    // Q/K normalisation: the squares, the reduction, the rsqrt
#endif
#ifndef NR_ABLATE_BIAS
#define NR_ABLATE_BIAS 0    // the Swin position bias load and add
#endif
#ifndef NR_ABLATE_RESID
#define NR_ABLATE_RESID 0   // the scaled residual seeded into the stage-2 accumulator
#endif
#ifndef NR_ACT_PACKED
#define NR_ACT_PACKED 1
#endif
#ifndef NR_POOL_VECTOR_STORE
#define NR_POOL_VECTOR_STORE 0
#endif
#ifndef NR_BLEND_VECTOR_LOAD
#define NR_BLEND_VECTOR_LOAD 0
#endif
// The fused image output's register epilogue. Documented at the
// `image_features` declaration; here so that passing it to a pipeline that has
// no fused image output is a build error rather than a silent no-op, which is
// the trap `NR_K_REGS` was caught in.
#ifndef NR_IMGOUT_REGS
#define NR_IMGOUT_REGS 0
#endif
