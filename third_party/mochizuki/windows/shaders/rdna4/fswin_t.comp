#ifndef NR_DUMP
#define NR_DUMP 0
#endif
#if NR_HWAVES && NR_DUMP
#error "NR_HWAVES has no per-wave copy of the whole block to dump"
#endif
// Evaluate the activation in f32 straight from the accumulator and convert
// once. Removes the f16 round trip the hardware forces on every quantisation
// (see nr_quant_pair32); changes the image, because NVIDIA's activation rounds
// in half. Off by default - this is a fidelity/speed choice, not a free win.
#ifndef NR_ACT_F32
#define NR_ACT_F32 0
#endif
// Three more instruction-budget ablations, diagnostic only, wrong output. See
// the block at the top of swin_math.glsl. These close the last of the C=32
// budget: the activation, exponential, probability sum and e4m3 clamp together
// account for 1260 of 3289 instructions and the rest was unattributed.
// Reduce a lane's own rows before the cross-lane exchange, so the half-wave
// boundary is crossed once rather than eight times. Changes the summation
// order, so it is a knob and not a cleanup.
// **K as A operands in registers, never through LDS.**
//
// NVIDIA's own C=32 fused Swin has `bar.sync` **zero** and 32 `movmatrix`: one
// warp owns the whole 64-token window, so K and V stay in registers and the
// transpose the logit product needs is a register instruction. We stage both
// through LDS - 32 `ds_store_b8`, a barrier, and the loads back - purely
// because `NR_FWAVES=2` splits the window across two waves that have to share.
//
// At one wave there is nobody to share with, and the transpose is free here
// too: an Accumulator's components **are** a transposed A operand on this
// hardware, measured ([[fragment-layouts-make-the-round-trip-optional]]). The
// K accumulator is [dim][token]; its transpose is [token][dim], which is
// exactly what `lds_k` held. With NR_FWAVES=1, NR_MF == NR_JF, so the register
// index is the logit loop's key-tile index unchanged.
//
// V is left in LDS: its accumulator is [dim][token] and the context product
// wants A = [dim][token], which is the *untransposed* orientation, and
// Accumulator -> A only gives the transpose.
//
// **Measured, and it does not pay. Default off.** At C=32, NR_FWAVES=1:
// 4673 instructions with K in LDS, **4771 with K in registers**. The transpose
// itself is free as advertised, but the component copy that performs it is
// not: a coopmat's elements are individually addressed, so `kreg[m][d][c] =
// kf[c]` is 64 scalar moves across the eight fragments where the LDS route is
// eight `ds_store_b8` and one `ds_load_b64`. Register pressure did not move
// either - 192 VGPRs and 8 waves both ways.
//
// And the wave count it needs is itself a loss: NR_FWAVES=1 is 4673
// instructions a wave against two waves' 3214, better per MMA (21.4 against
// 25.7) but at 8 subgroups a SIMD instead of 10, and measured 4% slower in
// the frame. So NVIDIA's zero-barrier one-warp design does not port: their
// `movmatrix` is one instruction and our equivalent is sixty-four.
//
// **Both halves of that are now stale, and the second one twice over.**
// `NR_FWAVES=1` shipped as `NR_FW32=1`, so the wave count is no longer
// a cost of this knob - it is the shipping shape. And re-priced against that
// shape the register form is not +98 instructions and it does move the
// registers: at C=32, NR_FWAVES=1, the shipping defines,
//
//     K in LDS        4752 instrs  3743 VALU  192 VGPR  4096 B LDS  8 waves
//     K in registers  4757 instrs  3753 VALU  168 VGPR  2048 B LDS  9 waves
//
// +5 instructions, -24 VGPRs, half the LDS and a ninth subgroup a SIMD, at
// `kernel/gold` 94.2% unchanged - the arithmetic is identical, only the staging
// moves. Two interleaved standalone runs put it at 146.9 us @ 2668 MHz against
// 147.2 @ 2679, i.e. **-0.6% in cycles, consistently but marginally**. That is
// under the bar for a default change on one standalone layer; it wants an A/B
// in the frame at both extents before anyone moves it.
//
// **Measured: the answer is no.** Applied to the pipelines that may
// legally take it - the guard below is the other half of this change - the
// 1080p and 4K PNGs are `cmp`-identical to the shipping build's, which settles
// "only the staging moves", and the time is a wash:
//
//     1080p   A 21.69 Mcyc / 8.085 ms      K_REGS 21.69 / 8.080   **+0.0%**
//     4K      A 77.50     / 30.181        K_REGS 77.48 / 30.175   **-0.03%**
//
// two interleaved passes each, clocks 2679..2686 and 2567..2568 MHz. The -0.6%
// the standalone layer shows does not reach the frame: the ninth subgroup buys
// nothing where the frame's C=32 dispatches are not occupancy-bound, and the
// 64 scalar component moves it costs are paid either way. Default stays off,
// and the knob is `NR_K_REGS=1` in a pipeline's defines, which attaches
// it per pipeline rather than globally - for the reason immediately below.
#ifndef NR_K_REGS
// Under NR_HWAVES a wave owns all 64 tokens, so NR_MF == NR_JF and the register
// index of a K fragment *is* the logit loop's key-tile index: the LDS staging
// the token split needed has nobody left to share with.
#define NR_K_REGS NR_HWAVES
#endif
#if NR_HWAVES && !NR_K_REGS
#error "NR_HWAVES keeps K in registers"
#endif
// **The precondition the comment above states and nothing enforced.**
// `kreg` is declared `[NR_MF][NR_DF]` and the logit loop reads `kreg[j][d]`
// over `j < NR_JF`, so the register form needs `NR_MF >= NR_JF`: one wave
// owning the whole window. At `NR_FWAVES=2` a wave owns 32 of the 64 tokens,
// NR_MF is 2 against NR_JF's 4, and `kreg[2]`/`kreg[3]` are off the end of the
// array - half the keys are whatever was next in the register file. A frame
// built with `-DNR_K_REGS=1` passed globally therefore ran four *wrong*
// C=32 adapters (`fswinimagepreds32`, `fswinimagepost32`, `fswinpost32`,
// `fswinblendpost32`, all NR_FWAVES=2) and came back 0.6% faster for it. The
// standalone harness cannot catch this: it builds NR_FWAVES=1 and scores
// 94.2% either way.
#if NR_K_REGS && (NR_MF < NR_JF)
#error "NR_K_REGS needs one wave per window (NR_MF >= NR_JF): NR_FWAVES=1 or NR_HWAVES=1"
#endif
// Square and reduce the Q/K norm in f32 rather than packed f16. Changes the
