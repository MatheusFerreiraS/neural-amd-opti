                for (int c=0;c<8;++c)
                    lds_x[NR_LXB_ uint(n)*256u + lp*16u + rbase + uint(c)] = pooled[c/4][c%4];
#else
                for (int c=0;c<8;++c)
                    lds_v[lp*uint(NR_C) + uint(n)*16u + rbase + uint(c)] = pooled[c/4][c%4];
#endif
            }
