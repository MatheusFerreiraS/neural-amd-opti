#else
            if(store_pool) {
#endif
#if NR_QUANT_PAIRED
                for (int c=0;c<8;c+=2) {
                    fe4m3vec2 q=NR_POOL_Q(c);
                    pooled[c/4][c%4]=q.x;pooled[c/4][c%4+1]=q.y;
                }
#else
#endif
