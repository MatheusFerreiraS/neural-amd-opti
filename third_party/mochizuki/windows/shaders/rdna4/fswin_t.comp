                // twice) even under `precise` - not byte-identical.
                NR_F16 sum = pair + subgroupShuffleXor(pair,4u);
#else
                NR_F16 sum = NR_F16(pair + NR_F16(subgroupShuffleXor(float(pair),4u)));
#endif
