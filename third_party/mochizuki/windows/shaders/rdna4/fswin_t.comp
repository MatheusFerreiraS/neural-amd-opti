                const f16vec2 v2 = f16vec2(wide[c], wide[c+1]);
                const f16vec2 pr = v2 + unpackFloat2x16(subgroupShuffleXor(packFloat2x16(v2), 1u));
#endif
                const f16vec2 sm = pr + unpackFloat2x16(subgroupShuffleXor(packFloat2x16(pr), 4u));
