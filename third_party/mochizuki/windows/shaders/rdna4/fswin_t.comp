#define NR_YOUNG_THR 0
#endif
#ifndef NR_YOUNG_CUS
#define NR_YOUNG_CUS 64
#endif
#ifndef NR_YOUNG_POLLS
#define NR_YOUNG_POLLS 4096
#endif
