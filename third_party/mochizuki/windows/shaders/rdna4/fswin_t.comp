#else
            NR_STORE_ACC_COL(of,image_features,(tok0+uint(m)*16u)*32u+uint(n)*16u,32u);
#endif
#else
            if (!nr_tile_oob((tok0 + uint(m) * 16u) / 16u))
                NR_STORE_ACC_COL(of, act_f16,
                    pc.o_off / 2u + nr_tile_base((tok0 + uint(m) * 16u) / 16u)
