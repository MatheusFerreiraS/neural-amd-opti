#define NR_FAIR 0
#endif
#if NR_FAIR
        // Experiment: oldest-first wave arbitration makes the first
        // launched workgroups run items several times faster than the last
        // (in-kernel clocks), and an item held by a starved one blocks its
        // dependents. A workgroup more than NR_FAIR items ahead of the average
        // waits on the claim counter (a memory poll issues almost nothing), so
        // the younger waves on its SIMDs get the issue slots.
        ++nr_fair_done;
        if (tid == 0u) {
            for (uint nr_p = 0u; nr_p < 4096u; ++nr_p) {
                const uint nr_h = atomicAdd(nr_sync[pcp.sync_off + 0u], 0u);
                if (nr_fair_done * gl_NumWorkGroups.x <= nr_h + uint(NR_FAIR) * gl_NumWorkGroups.x ||
