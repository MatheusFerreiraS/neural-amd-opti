#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#ifndef NR_HALF_RTZ
#define NR_HALF_RTZ 0
#endif
#if NR_HALF_RTZ
// Experiment (off by default): changes all half arithmetic in this entry point,
// including reductions. Requires shaderRoundingModeRTZFloat16; accumulation
// remains FP32. This is not a per-conversion or NVIDIA-equivalent mode.
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(capabilities = [4468], 4463, 16);
#endif
#ifndef NR_PERSIST
#define NR_PERSIST 0
#endif
// A persistent run whose last layer is the level's fused downsample
// (the fswindsp body behind a wave-uniform branch). Host: NR_PERSIST_DS_MASK.
#ifndef NR_PERSIST_DS
#define NR_PERSIST_DS 0
#endif
// A persistent run whose first layer is the level's fused upsample
// (fswinfusedup's prologue and blend-staging behind a wave-uniform branch).
#ifndef NR_PERSIST_UPS
#define NR_PERSIST_UPS 0
#endif
#if NR_PERSIST_UPS && (!NR_PERSIST || NR_PERSIST_DS || !defined(NR_FUSED_UPS_BLEND) || \
    !defined(NR_WIDE_UPS_PROJECT) || !NR_HWAVES)
#error "NR_PERSIST_UPS: persistent head-split body with the wide fused upsample, not with NR_PERSIST_DS"
#endif
#if NR_PERSIST_DS && !NR_PERSIST
#error "NR_PERSIST_DS needs NR_PERSIST"
#endif
#if NR_PERSIST
// The claimed item arrives in a VGPR - it is the return of a global atomic -
// and every window coordinate derived from it would follow it into vector
// registers. `subgroupBroadcastFirst` is the one operation that tells ACO the
// value is wave-uniform, which is what keeps the addressing scalar; it needs
// the ballot extension, and `subgroupElect` the basic one, so both are
// required here and nowhere else (NR_PERSIST=0 SPIR-V is unchanged).
#extension GL_KHR_shader_subgroup_basic  : require
#extension GL_KHR_shader_subgroup_ballot : require
#endif
// NR_WAVE_UNIFORM: tid/32 is one value per wave (a wave is 32
// consecutive invocations), but NIR sees a divergent value and keeps every
// quantity derived from it in VGPRs. Reading it through readfirstlane makes
// the same value scalar.
#ifndef NR_WAVE_UNIFORM
#define NR_WAVE_UNIFORM 0
#endif
#if NR_WAVE_UNIFORM
#extension GL_KHR_shader_subgroup_ballot : require
#define NR_WAVE_OF(t) subgroupBroadcastFirst((t) / 32u)
#else
#define NR_WAVE_OF(t) ((t) / 32u)
#endif

// e4m3 quantisation straight from f32, one rounding instead of two. Set here
// rather than in coopmm.glsl because it is a decision about *this* kernel: the
// f32 entry point removes 415 instructions at C=32 - the f16 narrowing that
// every f32 call site was paying on the way into a clamp it then did in f16 -
// and this shader has already given up bit-agreement with NVIDIA's f16
// accumulator (NR_ACC_F16 below), so the second rounding buys nothing here. It
// still buys agreement in `attn.comp`, which keeps mode 1.
//
//   mode 1 (was)  191.7 us at C=32, 3253 instructions, gold 90.8%
//   mode 0        178.6 us,         2896 instructions, gold **91.2%**
//
// The clamp itself stays. `NR_QUANT_MODE=3` drops it and is 5.5% faster with a
// bit-identical score on this corpus - and the corpus is not the network: NVIDIA's
// own 1080p capture has **2.38 M bytes at exactly 0x7E**, e4m3's largest finite
// value, 18% of `b031l2_o2` and of `b032l0`. Saturation happens, the guard is
// load-bearing, and the only reason that is known is that the capture was
// searched for it instead of the comment being believed.
//
// **Mode 4 is the default and it is safe on any driver.** It spells the clamp as
// SPV_EXT_float8's saturating conversion, which RADV 26+ lowers to a bare
// `v_cvt_pk_fp8_f32` with the MODE register FP16_OVFL bit - no VALU per value -
// and which RADV 25.2.8 lowers to *byte-identical ISA to the hand-written
// clamp*. Measured both ways, so there is nothing to detect at build time:
//
//   Mesa 26.2.2   mode 0: 6683 instructions, 768 clamps,   0 s_setreg
//                 mode 4: 4828 instructions,   0 clamps, 363 s_setreg
//
// **Those three numbers were once 2930/440/0 and 2681/128/143, and none of
// them was ever real.** Counted from the ISA on the shipping
// C=32 shape (`NR_FWAVES=1`, `NR_K_REGS=1`, `NR_NORM_F32=1`, `NR_IMAGE=1`); the
// old row came off RADV's own listing, which desynchronises on the 8-byte
// converts and loses 13.7% of this shader's instructions. Two of the errors are
// not shape drift and could not be:
//
//   * **mode 4 cannot have any clamps.** The whole point of the mode is that
//     the clamp becomes the saturating conversion, and `v_maxmin_num_f32` is
//     0 in it, not 128 - the same correction as in `coopmm.glsl`.
//   * 143 `s_setreg` against 363 is the disassembler's near-halving signature,
//     exactly as "163 MODE writes for 182 converts" turned out to be 343 for
//     384.
//
// The Mesa 25.2.8 row ("2892 instructions, 448 clamps, identical") is removed
// rather than corrected: that driver is not installed and the claim cannot be
// re-counted, so it would be an uncheckable number sitting beside two checked
// ones. The *behaviour* it recorded - 25.2.8 lowering mode 4 to the same ISA as
// the hand-written clamp - is not disturbed by this and is left in the prose.
//
// and on 26.2.2 that is 178.0 -> 166.3 us at C=32, 122.6 -> 111.3 at C=64,
// 100.4 -> 93.8 at C=128, and a wash at C=256 - **3.3% off the family with the
// gold byte-identical at all four widths**. The clocks were if anything lower
// on the faster side, so the win is understated.
#ifndef NR_QUANT_MODE
#define NR_QUANT_MODE 4
#endif
#include "coopmm.glsl"
#include "swin_math.glsl"

// The fused Swin block, carried **transposed**: every matrix is
// [feature][token], weights are the A operand and activations are B.
//
// Why the orientation matters more than anything else here: `coopmm.glsl`
// records the measured fragment layout on this target, and an Accumulator's
// components *are* a B operand's and are a transposed A operand's. So an
// intermediate becomes the next matmul's operand by assigning its components
// across - no memory, no barrier - **provided the accumulator's row index is
// the next contraction index**. In the natural [token][feature] orientation it
// never is, and the untransposed `fswin.comp` pays for that with seven LDS round trips.
// Transposed, every hop lines up:
//
//     expand -> (grouped middle) -> contract -> QKV -> logits -> ctx -> out
//
// and the only arrays left are K and V, which are shared across waves and so
// have to be in LDS regardless. 6144 B at C=32 against 20992.
//
// Two more things fall out of the layout rather than being arranged:
//   * the residuals are element-wise adds - `rs[n]` is per accumulator *row*,
//     so it is per component, and `x` loads as a B fragment carrying the
//     accumulator's own map. `fswin.comp` needs a diagonal matrix and two extra
//     MMAs for the same thing.
//   * L2-normalising Q and K is a *column* reduction: eight components inside
//     one lane plus a single shuffle. So is the softmax denominator, because
//     the logits are computed transposed as S^T = K.Q^T.
//
// The pinned native-FP8 PTX quantizes normalized Q (after head scale), K and V
// to e4m3 before their products. The old CPU reference omitted Q/K conversion
// and is not an independent specification.

#ifndef NR_C
#define NR_C 32
#endif
#ifndef NR_HEADS
#define NR_HEADS 1
#endif
#define NR_H    (4 * NR_C)
#define NR_HD   (NR_C / NR_HEADS)       // head dim
#define NR_WIN  64
// Waves a workgroup, and through NR_MF the register-blocking factor. LDS is
// 6144 B at every width, so this is purely a register trade.
//
// **Re-measured at the window count each width actually has at 1080p**, because
// the previous choice was made at a flat 1024 windows for all four and the real
// counts are 8160 / 2040 / 510 / 135. Three of the four were right anyway; C=64
// was not:
//
//     C=32  win 8160   fw1 293.4   **fw2 245.8**   fw4 256.2
//     C=64  win 2040                 **fw2 189.3**   fw4 208.9   <- was 4
//     C=128 win  510                   fw2 167.9   **fw4 162.5**
//     C=256 win  135                   fw2 439.4   **fw4 312.0**
//
// Gold is identical at every setting - this is a work split, not arithmetic.
// The old note's reason for four at the wider widths ("at two the QKV
// projection spills") still holds at C=128 and C=256 and evidently does not at
// C=64, where two waves win by 1.10x.
//
// The same mistake in `attn.comp` was worth 2.83x, so **choose a wave count at
// the launch size the layer really has**, not at whatever saturates the GPU.
// Re-swept once NR_ACC_F16 and NR_QUANT_MODE changed the instruction mix, and
// **C=128 had the wrong value**: two waves is 94.0 us against four's 112.9,
// 1.20x, worth 0.23 ms over its twelve layers. The other three were right.
//
//   NR_FWAVES        1        2        4
//   C=32          188.7  **180.5**   192.5
//   C=64          170.9  **125.3**   129.5
//   C=128         120.4   **94.0**   112.9   <- was 4
//   C=256         422.5    145.6  **111.4**
//
// The pattern is not "more waves is more parallelism": four waves at C=128 has
// twice the waves and 13.7 instructions per WMMA against two waves' 11.9, and
// the denser one wins. Only C=256, where a wave's share of the window is small
// enough that four still fills it, prefers four. Gold is identical in all
// twelve cells - this is a work split.
// **Two, at every width, and the exception at C=256 was a property of the old
// driver.** Re-swept on RADV 26.2.2 - which is what the deployment machine runs
// - at a budget that saturates the clock:
//
//   NR_FWAVES     1       2        4
//   C=32       173.9  **166.9**  174.8
//   C=64       182.6  **112.6**  117.7
//   C=128      110.6   **89.8**   97.7
//   C=256      590.6  **159.4**  194.3   <- was 4, on RADV 25.2.8
//
// On 25.2.8 C=256 preferred four (111.4 against two waves' 145.6) and here it
// prefers two by 16%. **The ranking inverted with the driver**, which is the
// same lesson as every other re-sweep in this file: a knob measured under one
// configuration is a fact about that configuration. Gold is identical in all
// twelve cells either way - this is a work split, not arithmetic.
//
// Worth 0.56 ms over the family's 44 layers.
#ifndef NR_FWAVES
#define NR_FWAVES 2
#endif
// **One wave per head, and the whole window per wave.** NVIDIA's own
// `cc_tinlayout_fused_swin_8h_256_8_fp8` launches 32x8 with 16384 B of shared:
// a warp per head, each owning all 64 tokens. NR_FWAVES splits the *tokens*
// instead, so every wave computes every head, and at C=256 the level has 135
// windows - 540 waves on 256 SIMDs, which is where its 1.61x efficiency gap
// between 1080p and 4K comes from. Splitting by head gives NR_HEADS waves a
// window and NR_MF = 4, so one weight fragment serves four MMAs.
//
// The cost is that x, the middle output and the context can no longer live in
// registers: each is produced by the wave that owns those rows and consumed by
// every wave. Two NR_WIN*NR_C e4m3 exchange buffers carry them, in the arena's
// own tile-blocked layout so a fragment round trip is one store and one load.
//
// **Measured at C=256 and it does not pay. Default 0 at every width.** The
// output is byte-identical - the whole frame's PNG cmps equal at both extents,
// and the fswin benchmark scores 68.1% at C=256 and 76.5% at C=128 either way - so
// this is a work split and nothing else, and it is 25% slower:
//
//   fswin256, 15 dispatches, 1080p   115.9 us  ->  144.5 us   (+24.7%)
//                            4K      290.8 us  ->  410.9 us   (+41.3%)
//   frame, clock-normalised  1080p     9.13 ms ->    9.79 ms
//                            4K       31.62 ms->   34.13 ms
//
// Occupancy was not the bound. The split doubles the waves a window to 8 and
// puts all 1080 of the level's waves resident at once, which is what it was
// for; what it costs is register reuse. In the token split the expand stage
// reads x sixty-four times out of *registers* (1024 MMAs off 16 fragments);
// here every one of its 512 MMAs takes an `ds_load_b64`, and the contract, the
// QKV and the output projection reload their operands too - 52 static LDS
// instructions become 288, and four barriers a window instead of sixteen buys
// back nothing like that. VGPRs 240 -> 256 (2 spilled), LDS 20480 -> 32768,
// subgroups a SIMD 6 -> 5.
//
// Two things inside it were worth having found, and both are general: a
// coopmat array indexed by anything ACO cannot fold lands in scratch (385
// spilled VGPRs), and a weight load that does not depend on the token block
// gets hoisted out of an unrolled m loop (96 live fragments, 207 spilled) -
// the fix for the second is the k-outer nest every other stage already has.
//
// **The restructure meant to fix the registers did not, and the reason
// is worth keeping.** Three arithmetic-preserving changes, in this order: the
// QKV projection in three passes of 8 accumulators where one pass held 24
// (192 VGPRs live); the logits and softmax one query fragment at a time, so
// `pq2`'s 64 VGPRs are born and die inside the iteration and only `pb`
// survives; the expand taking two weight rows a k step so each B fragment
// feeds two MMAs. C=256, shipping defines, `NR_HWAVES=1`:
//
//                     VGPRs spill   LDS  subgrp  Instr  VALU  wmma  ds_load
//   base, NR_HWAVES=0   240     0 20480       6   7375  4525   768       32
//   NR_HWAVES before    256     2 32768       5   6740  5012   917      268
//   after QKV split     256    15 32768       5   7547  5486  1277      328
//   + softmax m-outer   256    15 32768       5   7558  5488  1277      328
//   + paired expand     256    15 32768       5   7543  5494  1279      328
//   + opaque LDS offsets 192     0 32768       8   8230  5545  1278      776
//   + y not held        192     0 32768       8   7824  5232  1216      716
//
// **C=128 too, once the mode carried its norm.** C=128 shipped NR_NORM_F32=0,
// the packed-f16 Q/K reduction; the three-pass QKV above splits Q and K into
// passes whose accumulators are never live together, so the packed pair is
// taken one half at a time - exact, because a packed f16 op rounds its halves
// independently, so the pair was always two scalar chains. C=128, shipping
// defines:
//
// **...and C=128 was then flipped to NR_NORM_F32=1, because the head split is what
// the old verdict was measured without.** The NF table came from NR_HWAVES=0
// builds and blamed occupancy: the f32 form's single cross-lane exchange has
// nothing to hide it at five subgroups a SIMD. The mode below takes C=128 to
// eight, and the sign inverts - `t_c128`, 510 windows, interleaved, in cycles
// because the harness's clock ranged over 2828..3021 MHz in the same session:
//
//     NR_HWAVES=0   nf0 247.5 kcyc   nf1 296.2 kcyc     nf1 **+19.7%**
//     NR_HWAVES=1   nf0 267.2 kcyc   nf1 238.9 kcyc     nf1 **-10.6%**
//
// `kernel/gold` is 76.5% in all four and `kernel/host` 71.9 -> 72.0, so unlike
// the other three widths C=128 does not even pay the two tenths. The reading
// was right and it expired when the shape it was measured on changed.
//
//                     VGPRs spill   LDS  subgrp  Instr  VALU  wmma  ds_load
//   base, NR_HWAVES=0   256     7 12288       5   6162  4061   540       32
//   NR_HWAVES=1         192     0 16384       8   6617  4390   672      394
//
// and the 7 spilled VGPRs are 1024 bytes of scratch the head split has none
// of. Both ship (`NR_HW128`, `NR_HW256`).
//
// **The LDS loads were never one per MMA.** Per barrier region after the
// first three: the expand and middle issued **64 `ds_load` for 575 `v_wmma`**
// (a per-barrier-region static count on a kernel that no longer exists -
// the shipping C=32 build has 16 `ds_load_b64` and 256 `v_wmma` in total - and
// it is not re-derivable, so read the *ratio*, not the numbers) - NIR
// has already CSE'd each (m, k) B fragment into one load, no store to `lds_x`
// intervening, so every one of them feeds all eight h rows. Pairing h
// therefore changed the `ds_load` count by exactly zero.
//
// **And that CSE *is* the register pressure.** Sixty-four CSE'd fragments are
// 128 VGPRs live across a stage. The fused QKV was safe from it only by
// accident: 24 live accumulators kept its k loop rolled - 88 static `v_wmma`
// in the whole QKV/attention region. Dropping to 8 let NIR unroll all three
// passes (448 static `v_wmma`, 128 `ds_load` in that region), and the
// unrolled body's CSE'd x fragments take ACO's pre-schedule demand from 258
// to 271, past the 256 cap; it spills the 16 VGPRs of `yq`, which live from
// stage 2 to the output projection - 15 `scratch_store` in the QKV region and
// 15 `scratch_load` in the projection. **Fewer accumulators bought more
// pressure.** The three passes also read `lds_x` twice more than the fused
// one did.
//
// So the lever was not a loop nesting: it was keeping the staged B fragments
// out of the CSE's reach. **Both.** A distinct multiple of an opaque zero -
// `gl_WorkGroupID.z`, which `nr_graph` always dispatches as 1 deep - in each
// load site's offset makes the loads un-mergeable, and re-reading `lds_x`
// where it is used instead of holding it takes ACO's pre-schedule demand from
// 271 to 159 and the allocation from 256-with-15-spilled to 192: **8
// subgroups per SIMD, up from 5**. The `ds_load` count is what the shape
// always implied - per barrier region, 256 loads for 576 MMAs in the expand
// and middle (64 a pair, 4 pairs), 136 for 128 in the contract, 256 for 448
// in QKV and attention, 68 for 64 in the output projection.
//
// The second half is `yq`: seeding the output projection's `ars` residual by
// reloading the wave's own rows from `lds_x`, where stage 2 already wrote
// them, instead of carrying four fragments through the attention. Those were
// exactly the 15 VGPRs that spilled. 406 fewer instructions than the opaque
// offsets alone, because the scratch traffic goes with them.
//
// In the frame (three runs an extent, --spv-dir):
// **1080p 9.145 -> 8.780 ms, 4K 31.606 -> 31.014**, both PNGs byte-identical
// to the token split's. fswin256 is 116.3 -> 91.3 us a dispatch at 1080p and
// 289.4 -> 253.6 at 4K; standalone t_c256 114.9 us @ 3093 MHz -> 87.55 @ 3010.
// **A wave owning more than one head is priced out, not unbuilt.**
// `nrhw_h = int(wave)` below is one head a wave by construction, so the shape
// between this and the one-wave one is a rewrite; it is also dead before the
// rewrite starts. Occupancy here is LDS bytes per *wave* and `lds_x`/`lds_y`
// are sized by the window, so halving a window's waves doubles its LDS a wave
// and halves its subgroups a SIMD, one for one: C=256 on four waves is 32768 B
// over four, 8192 a wave, **four** subgroups against today's eight. Every
// shipping fswin pipeline is at 4096 B a wave, which is the measured knee exactly.
#ifndef NR_HWAVES
#define NR_HWAVES 0
#endif
#if NR_HWAVES
#if NR_HEADS < 2
#error "NR_HWAVES splits the window by head; NR_HEADS must be at least 2"
#endif
#if defined(NR_FUSED_IMAGE_INPUT) || defined(NR_FUSED_IMAGE_OUTPUT) \
 || defined(NR_INPUT_F16) || defined(NR_FUSED_POST_BLEND) || defined(NR_FINAL_F16)
#error "NR_HWAVES does not support the fused image / post variants"
#endif
#define NR_THREADS (32 * NR_HEADS)
#define NR_MTOK NR_WIN                  // one wave owns the whole window
#else
#define NR_THREADS (NR_FWAVES * 32)
#define NR_MTOK (NR_WIN / NR_FWAVES)    // tokens a wave owns
#endif

// Every count is a plain division: nothing here is a magic literal, and the
// guards below fail the build rather than the score if a width does not tile.
#define NR_MF  (NR_MTOK / 16)           // token fragments a wave owns
#define NR_CF  (NR_C / 16)              // fragments across C
#define NR_HF  (NR_H / 16)              // ... across the hidden
#ifndef NR_STREAM_MLP
#define NR_STREAM_MLP 0
#endif
#define NR_STREAM_C32 (NR_STREAM_MLP && NR_C == 32)
#ifndef NR_PACK_C32
#define NR_PACK_C32 0
#endif
#define NR_PACK_C32_ACTIVE (NR_PACK_C32 && NR_C == 32)
#define NR_QF  (3 * NR_C / 16)          // ... across the 3C QKV rows
#define NR_DF  (NR_HD / 16)             // ... across one head's dim
#define NR_JF  (NR_WIN / 16)            // ... across the window's key tokens
#if NR_HEADS > 1
// The middle convolution is block diagonal over heads: output group g reduces
// only hidden group g, and the stored tensor is one group's [C][H/heads].
#define NR_HG  (NR_H / NR_HEADS)
#define NR_HGF (NR_HG / 16)
#define NR_KCF NR_CF                    // the contract then reduces C
#else
#define NR_KCF NR_HF                    // ... or the hidden directly
#endif
#if NR_MF * 16 != NR_MTOK || NR_MF > 4
#error "NR_FWAVES must divide the window into whole 16-token fragments"
#endif
#if NR_DF * 16 != NR_HD || NR_CF * 16 != NR_C
#error "C and C/heads must both be multiples of 16"
#endif
#if NR_HWAVES && (NR_DF * NR_HEADS != NR_CF || NR_MF != NR_JF)
#error "NR_HWAVES needs the channel fragments to partition across heads"
#endif

// The register-blocking knob is NR_FWAVES, through NR_MF: at 6144 B of LDS and
// ~144 VGPRs there is room to widen M, and each weight fragment then serves
// NR_MF token blocks instead of one. Measured at C=32, 1024 windows: four waves
// 27.55 us, two waves 26.10, one wave 68.86 and spilling.

// Emulating NVIDIA's blocked f16 accumulator, at the k-step interval given.
// gfx1201 has no f16 accumulator for FP8 operands, so every rounding is
// software - and at C=32 the emulation is **30% of the kernel's instructions**:
// 828 `v_cvt` and 576 `v_pk_*` against 128 `v_wmma` in a 4601-instruction
// shader. **0 turns it off and is the default.**
//
// **Those four counts are per *wave* at `NR_FWAVES=2`, not per window**, and
// the shipping C=32 kernel is now `NR_FW32=1` - one wave owning the
// whole window, 256 `v_wmma` and 4752 instructions with the emulation off. So
// the ratio may still be about right and the absolutes are a launch shape that
// is gone; they were not re-derivable here and are left labelled rather than
// replaced. See the `count-per-window-not-per-wave` note.
//
// Measured at 1080p window counts, timed and scored in the same run:
//
//   NR_ACC_F16      2      3      4      8     16    **0**
//   C=32  us      246.2  205.3  203.6  195.9  191.4  **191.7**
//         gold     91.3   91.2   91.4   91.2   90.8    90.8
//   C=256 us      310.0  305.5  297.4  290.0  286.4  **115.0**
//         gold     70.8   67.9   67.9   68.2   68.6    68.4
//
// **1.28x at C=32 and 2.63x at C=256**, for 0.5 and 2.4 points of gold. Over
// the 44 layers the family goes 10.30 ms -> 5.81.
//
// Two things that look like the reason and are not. It is **not the number of
// roundings**: at C=256 the k loop is 16 steps, so NR_ACC_F16=16 rounds once
// and still costs 286 us. And it is **not occupancy**: C=256 goes from 143
// VGPRs to 223 when the rounding is removed, i.e. it gets *worse*, and is 2.7x
// faster anyway. What is left is that touching accumulator components
// individually forces ACO to materialise the accumulator out of its packed
// WMMA form, and the whole k loop then runs unpacked.
//
// **What the score column does and does not say.** `kernel/gold` is agreement
// with NVIDIA's own output, which was produced *with* their rounding, so
// removing ours must lower it and that is not an accuracy statement. The test
// is `kernel/host`, against our FP32 reference - and it does not move either
// (89.7 -> 89.2 at C=32, 71.9 -> 71.1 at C=256). All three metrics are bit
// agreement dominated by e4m3's 3-bit mantissa, where one ulp is 6-12%
// relative; neither setting is meaningfully more correct than the other.
// Matching NVIDIA is verification, not quality. Set 2 to do the verification.
#ifndef NR_PTX_ACC
#define NR_PTX_ACC 1
#endif
#ifndef NR_ACC_F16
// Residual placement and accumulator precision are independent. Keep FP32
// default; explicit FP16 rounding is selected by the build/user policy.
#define NR_ACC_F16 0
#endif
#ifndef NR_NATIVE_RESIDUAL
// User accepted the native half residual path's full-image differences for
// its measured speedup. Keep the explicit-rounding policy on its prior path.
#define NR_NATIVE_RESIDUAL (NR_ACC_F16 == 0)
#endif
// r9: paired scalar math and a compact FP8 context staging path. Keep the
// explicit accumulator-rounding policy unchanged. See the r9 performance audit.
#ifndef NR_PACKED_SWIN_MATH
#define NR_PACKED_SWIN_MATH (NR_ACC_F16 == 0)
#endif
#ifndef NR_CONTEXT_LDS
#define NR_CONTEXT_LDS (NR_ACC_F16 == 0 && NR_C >= 128 && !NR_HWAVES)
#endif
#ifndef NR_SWIN_BIAS_F16
// Standalone callers retain the original FP32 weight-buffer contract.
